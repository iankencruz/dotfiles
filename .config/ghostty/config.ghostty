# Config generated by Ghostty Config

theme = noctalia
background = #1e1e2e
foreground = #cdd6f4
selection-background = #585b70
selection-foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f37799
palette = 10=#89d88b
palette = 11=#ebd391
palette = 12=#74a8fc
palette = 13=#f2aede
palette = 14=#6bd7ca
palette = 15=#bac2de


# scroll terminal up & down
keybind = shift+home=scroll_page_lines:-25
keybind = shift+end=scroll_page_lines:25

# create splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+b=new_split:down

# close surface
keybind = ctrl+w=close_surface
keybind = ctrl+d=unbind



# arrow splits
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_up=goto_split:up

# vim splits
# keybind = alt+h=goto_split:left
# keybind = alt+j=goto_split:down
# keybind = alt+k=goto_split:up
# keybind = alt+l=goto_split:right

# resize splits
keybind = ctrl+shift+alt+arrow_down=resize_split:down,50
keybind = ctrl+shift+alt+arrow_left=resize_split:left,50
keybind = ctrl+shift+alt+arrow_up=resize_split:up,50
keybind = ctrl+shift+alt+arrow_right=resize_split:right,50

# splits next and prev
keybind = alt+minus=goto_split:previous
keybind = alt+equal=goto_split:next

theme = noctalia

